{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "allowed_origins": [],
    "enable_logging": false,
    "disable_content_logging": true,
    "retain_content_in_object_storage": false,
    "allow_per_request_content_storage_override": false,
    "allow_per_request_raw_override": true,
    "enforce_auth_on_inference": true,
    "allow_direct_keys": false,
    "max_request_body_size_mb": 16
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/tmp/bifrost-config.db"
    }
  },
  "logs_store": {
    "enabled": false
  },
  "governance": {
    "auth_config": {
      "is_enabled": false,
      "disable_auth_on_inference": false
    },
    "virtual_keys": [
      {
        "id": "omni-ielts-app",
        "name": "Omni IELTS Express backend",
        "value": "env.BIFROST_VIRTUAL_KEY",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "gemini",
            "allowed_models": [
              "gemini-3.7-flash",
              "gemini-3.6-flash",
              "gemini-3.5-flash",
              "gemini-3.5-flash-lite",
              "gemini-3.1-flash-tts-preview"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          },
          {
            "provider": "groq",
            "allowed_models": ["groq/compound-mini", "groq/compound", "openai/gpt-oss-120b"],
            "key_ids": ["*"],
            "weight": 1
          },
          {
            "provider": "nvidia_nim",
            "allowed_models": ["meta/llama-3.3-70b-instruct"],
            "key_ids": ["*"],
            "weight": 1
          },
          {
            "provider": "openrouter",
            "allowed_models": ["openrouter/free"],
            "key_ids": ["*"],
            "weight": 1
          }
        ]
      }
    ]
  },
  "providers": {
    "gemini": {
      "keys": [
        {
          "name": "gemini-project-primary",
          "value": "env.GEMINI_API_KEY",
          "models": ["*"],
          "weight": 1
        },
        {
          "name": "gemini-project-2",
          "value": "env.GEMINI_API_KEY_2",
          "models": ["*"],
          "weight": 1
        },
        {
          "name": "gemini-project-3",
          "value": "env.GEMINI_API_KEY_3",
          "models": ["*"],
          "weight": 1
        },
        {
          "name": "gemini-project-4",
          "value": "env.GEMINI_API_KEY_4",
          "models": ["*"],
          "weight": 1
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 120,
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      }
    },
    "groq": {
      "keys": [
        {
          "name": "groq-primary",
          "value": "env.GROQ_API_KEY",
          "models": ["groq/compound-mini", "groq/compound", "openai/gpt-oss-120b"],
          "weight": 1
        },
        {
          "name": "groq-2",
          "value": "env.GROQ_API_KEY_2",
          "models": ["groq/compound-mini", "groq/compound", "openai/gpt-oss-120b"],
          "weight": 1
        },
        {
          "name": "groq-3",
          "value": "env.GROQ_API_KEY_3",
          "models": ["groq/compound-mini", "groq/compound", "openai/gpt-oss-120b"],
          "weight": 1
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 120,
        "max_retries": 1
      }
    },
    "nvidia_nim": {
      "keys": [
        {
          "name": "nvidia-nim-primary",
          "value": "env.NVIDIA_NIM_API_KEY",
          "models": ["meta/llama-3.3-70b-instruct"],
          "weight": 1
        },
        {
          "name": "nvidia-nim-2",
          "value": "env.NVIDIA_NIM_API_KEY_2",
          "models": ["meta/llama-3.3-70b-instruct"],
          "weight": 1
        },
        {
          "name": "nvidia-nim-3",
          "value": "env.NVIDIA_NIM_API_KEY_3",
          "models": ["meta/llama-3.3-70b-instruct"],
          "weight": 1
        }
      ],
      "network_config": {
        "base_url": "https://integrate.api.nvidia.com/v1",
        "default_request_timeout_in_seconds": 120,
        "max_retries": 1
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": false
        },
        "request_path_overrides": {
          "chat_completion": "/chat/completions"
        }
      }
    },
    "openrouter": {
      "keys": [
        {
          "name": "openrouter-primary",
          "value": "env.OPENROUTER_API_KEY",
          "models": ["openrouter/free"],
          "weight": 1
        },
        {
          "name": "openrouter-2",
          "value": "env.OPENROUTER_API_KEY_2",
          "models": ["openrouter/free"],
          "weight": 1
        },
        {
          "name": "openrouter-3",
          "value": "env.OPENROUTER_API_KEY_3",
          "models": ["openrouter/free"],
          "weight": 1
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 120,
        "max_retries": 1
      }
    }
  }
}
