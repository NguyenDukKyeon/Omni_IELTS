{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:sources:rls:db": "tsx scripts/test-sources-rls-postgres.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:web-bridge:live": "node scripts/web-bridge-live-canary.mjs",
    "check:web-bridge:live": "npm run test:web-bridge:live",
    "setup:web-bridge": "npm run setup:web-bridge:pro",
    "setup:web-bridge:pro": "tsx scripts/web-bridge-session.ts setup",
    "sync:web-bridge:session": "tsx scripts/web-bridge-session.ts sync",
    "check:ux-contracts": "tsx scripts/check-ux-contracts.ts",
    "check:product-docs": "tsx scripts/check-product-docs.ts",
    "check:gate": "node scripts/public-beta-gate.mjs --mode=deterministic",
    "check:beta": "node scripts/public-beta-gate.mjs --mode=deterministic",
    "check:release": "node scripts/public-beta-gate.mjs --mode=full",
    "check:canary:live": "node scripts/public-beta-gate.mjs --mode=live",
    "check:live": "node scripts/public-beta-gate.mjs --mode=live",
    "check:release:full": "node scripts/public-beta-gate.mjs --mode=full"
  },
  "dependencies": {
    "@fontsource-variable/onest": "5.3.0",
    "@google/genai": "^2.4.0",
    "@mozilla/readability": "0.6.0",
    "@ricky0123/vad-web": "0.0.30",
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dompurify": "3.4.14",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsdom": "30.0.1",
    "lucide-react": "^0.546.0",
    "mammoth": "1.12.2",
    "motion": "^12.23.24",
    "pdf-parse": "2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "ts-fsrs": "^5.4.1",
    "vite": "^6.2.3",
    "wavesurfer.js": "^7.12.11",
    "xstate": "^5.32.5",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "8.23.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pg": "8.23.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  }
}
