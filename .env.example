# Gemini API Key for server-side AI endpoints
GEMINI_API_KEY=
# Additional Gemini keys should belong to different Google Cloud projects.
# Multiple keys from the same project share the same project-level quota.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# Groq fallback for grounded search when Gemini quota/provider is unavailable
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Optional independent Web Search fallback. Search results are converted to a verified evidence bundle before AI synthesis.
BRAVE_SEARCH_API_KEY=
# Shared Forecast snapshot cache. Six hours avoids spending one Search call per learner refresh.
FORECAST_CACHE_TTL_MS=21600000
FORECAST_CACHE_PATH=.data/forecast-snapshots.json
FORECAST_CACHE_MAX_ENTRIES=100
# Zero-cost text fallbacks routed only through the internal Bifrost sidecar
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_KEY_2=
NVIDIA_NIM_API_KEY_3=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
# Generate a long random value locally; never commit the real value.
BIFROST_VIRTUAL_KEY=
AI_GATEWAY_BASE_URL=http://bifrost:8080
AI_GATEWAY_ENABLED=true
# Optional private/dev text fallback. Generate WEB_AI_BRIDGE_API_KEY locally.
WEB_AI_BRIDGE_ENABLED=false
WEB_AI_BRIDGE_KIND=gemini-web2api
WEB_AI_BRIDGE_BASE_URL=http://gemini-web2api:8081/v1
WEB_AI_BRIDGE_API_KEY=
WEB_AI_BRIDGE_MODEL=gemini-3.1-pro
# Internal authenticated Gemini Web order for deep tasks. Flash Lite remains reserved for instant tasks.
WEB_AI_BRIDGE_PRIMARY_MODEL=gemini-flash
WEB_AI_BRIDGE_FALLBACK_MODEL=gemini-pro
WEB_AI_BRIDGE_PRIORITY=prefer_deep
WEB_AI_BRIDGE_REQUEST_TIMEOUT_SEC=75
WEB_AI_BRIDGE_MODEL_ATTEMPT_TIMEOUT_SEC=40
# Absolute path only. The JSON session is stored outside the repo and mounted read-only.
WEB_AI_BRIDGE_COOKIE_HOST_PATH=
# Private/dev only: fallback budget after the authenticated deep lane is unavailable.
WEB_AI_BRIDGE_PRIMARY_TIMEOUT_MS=20000
# Optional operator-only Sub2API installation. It is not part of the public fallback chain.
SUB2API_ENABLED=false
SUB2API_FALLBACK_MODE=canary
SUB2API_BASE_URL=http://sub2api:8080
SUB2API_DASHBOARD_PORT=8082
SUB2API_TEXT_API_KEY=
SUB2API_GROUNDED_API_KEY=
SUB2API_TEXT_MODEL=
SUB2API_GROUNDED_MODEL=
OMNI_CANARY_TOKEN=
# Optional: make Gemini Web and all provider canaries target the same production-like app.
OMNI_CANARY_BASE_URL=
SUB2API_POSTGRES_PASSWORD=
SUB2API_REDIS_PASSWORD=
SUB2API_JWT_SECRET=
SUB2API_TOTP_ENCRYPTION_KEY=
# Optional no-cookie PO-token sidecar used by compose.media.yml
YT_DLP_POT_PROVIDER_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
